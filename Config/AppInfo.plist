<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Only keys that INFOPLIST_KEY_*
	     build settings cannot express live here. -->
	<!-- Stage mode floating prompter: the mic keeps listening while the
	     user-started Picture-in-Picture window is up. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.teaminpact.mobileprompt.handoff</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>voiceprompter</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
